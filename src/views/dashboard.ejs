<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View Registered Users</a></p>
    <% } %>

    <h2>Projects You Volunteer For</h2>
    <% if (volunteerProjects.length > 0) { %>
        <ul class="content-grid volunteer-list">
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    <p><strong>Organization:</strong> <%= project.organization_name %></p>
                    <p><strong>Date:</strong> <%= project.date %></p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <input type="hidden" name="returnTo" value="dashboard">
                        <button type="submit">Remove Me</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not signed up for any projects yet.</p>
    <% } %>
</main>
<%- include('partials/footer') %>