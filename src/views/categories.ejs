
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <!-- Put your page-specific content here -->
    <h2>Check out our service projects categories</h2>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-category">Add a Category</a></p>
    <% } %>

    <ul class="content-grid category-grid">
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>